# PostgreSQL runtime connection
DATABASE_URL="postgresql://YOUR_POOLER_TRANSACTION_URL:6543/postgres?pgbouncer=true&connection_limit=1"

# PostgreSQL migration / Prisma CLI connection
DIRECT_URL="postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres?sslmode=require"

# Optional test database
DATABASE_URL_TEST="postgresql://user:pass@localhost:5432/test_db"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# AI provider
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Application
NEXTAUTH_SECRET="YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
NEXTAUTH_URL="http://localhost:3000"

# Application Public Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Financial Management AI - CA Co-Pilot"

# Supabase CA certificate for production PostgreSQL TLS verification
SUPABASE_CA_CERT=""
