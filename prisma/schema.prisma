datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MovementType {
  STOCK_IN
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PurchaseBillStatus {
  DRAFT
  RECEIVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  REFUND
  CREDIT
  DEBIT
  OPENING_BALANCE
  ADJUSTMENT
}

model User {
  id                   String                @id @default(cuid())
  supabaseUserId       String                @unique
  email                String                @unique
  name                 String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  memberships          BusinessMember[]
  invitations          BusinessInvitation[]
  auditLogs            AuditLog[]
  createdProducts      Product[]             @relation("ProductCreatedBy")
  inventoryMovements   InventoryMovement[]   @relation("MovementCreatedBy")
  createdInvoices      Invoice[]             @relation("InvoiceCreatedBy")
  createdPayments      Payment[]             @relation("PaymentCreatedBy")
  reversedPayments     Payment[]             @relation("PaymentReversedBy")
  createdLedgerEntries CustomerLedgerEntry[] @relation("LedgerCreatedBy")
  createdTransactions  Transaction[]         @relation("TransactionCreatedBy")
  createdSuppliers     Supplier[]            @relation("SupplierCreatedBy")
  createdPurchaseBills PurchaseBill[]        @relation("PurchaseCreatedBy")
  createdPurchasePayments PurchasePayment[]  @relation("PurchasePaymentCreatedBy")
  createdExpenses      Expense[]             @relation("ExpenseCreatedBy")
}

model Business {
  id                    String                @id @default(cuid())
  name                  String
  accountType           String
  businessType          String
  country               String
  state                 String
  city                  String
  baseCurrency          String
  fiscalYearStart       String
  taxRegistrationStatus Boolean               @default(false)
  taxId                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  members               BusinessMember[]
  invitations           BusinessInvitation[]
  auditLogs             AuditLog[]
  products              Product[]
  batches               InventoryBatch[]
  inventoryMovements    InventoryMovement[]
  customers             Customer[]
  invoices              Invoice[]
  payments              Payment[]
  ledgerEntries         CustomerLedgerEntry[]
  invoiceSequence       InvoiceSequence?
  accounts              Account[]
  transactions          Transaction[]
  suppliers             Supplier[]
  purchaseBills         PurchaseBill[]
  purchasePayments      PurchasePayment[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  purchaseSequence      PurchaseSequence?
  expenseSequence       ExpenseSequence?
  transactionSequence   TransactionSequence?
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       Role     @default(STAFF)
  status     String   @default("ACTIVE") // ACTIVE, REMOVED, SUSPENDED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model BusinessInvitation {
  id           String           @id @default(cuid())
  businessId   String
  email        String
  role         Role             @default(STAFF)
  status       InvitationStatus @default(PENDING)
  invitedById  String
  invitedUserId String?
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([businessId])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
}

model Product {
  id                String              @id @default(cuid())
  businessId        String
  name              String
  description       String?
  SKU               String
  barcode           String?
  category          String?
  unit              String              @default("PCS")
  costPrice         Decimal             @default(0) @db.Decimal(15, 2)
  sellingPrice      Decimal             @default(0) @db.Decimal(15, 2)
  stockQuantity     Decimal             @default(0) @db.Decimal(15, 4)
  lowStockThreshold Decimal             @default(10) @db.Decimal(15, 4)
  taxCategory       String              @default("STANDARD")
  archived          Boolean             @default(false)
  createdById       String?
  updatedById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy         User?               @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  batches           InventoryBatch[]
  movements         InventoryMovement[]
  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseBillItem[]

  @@unique([businessId, SKU])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([businessId, archived])
  @@index([businessId, name])
  @@index([SKU])
  @@index([barcode])
}

model InventoryBatch {
  id                String              @id @default(cuid())
  businessId        String
  productId         String
  batchNumber       String
  quantity          Decimal             @db.Decimal(15, 4)
  remainingQuantity Decimal             @db.Decimal(15, 4)
  unitCost          Decimal             @db.Decimal(15, 2)
  receivedDate      DateTime            @default(now())
  expiryDate        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements         InventoryMovement[]

  @@index([businessId])
  @@index([productId])
  @@index([businessId, batchNumber])
}

model InventoryMovement {
  id                String              @id @default(cuid())
  businessId        String
  productId         String
  batchId           String?
  movementType      MovementType
  quantity          Decimal             @db.Decimal(15, 4)
  unitCost          Decimal?            @db.Decimal(15, 2)
  previousStock     Decimal             @db.Decimal(15, 4)
  resultingStock    Decimal             @db.Decimal(15, 4)
  reason            String?
  reference         String?
  createdById       String?
  createdAt         DateTime            @default(now())

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch             InventoryBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([productId])
  @@index([businessId, createdAt])
  @@index([businessId, movementType])
}

model Customer {
  id             String                @id @default(cuid())
  businessId     String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String?               @default("India")
  taxId          String?               // GSTIN / Tax ID
  notes          String?
  creditLimit    Decimal?              @db.Decimal(15, 2)
  openingBalance Decimal               @default(0) @db.Decimal(15, 2)
  currentBalance Decimal               @default(0) @db.Decimal(15, 2)
  archived       Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  payments       Payment[]
  ledgerEntries  CustomerLedgerEntry[]

  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, archived])
}

model CustomerLedgerEntry {
  id           String          @id @default(cuid())
  businessId   String
  customerId   String
  invoiceId    String?
  paymentId    String?
  entryType    LedgerEntryType
  amount       Decimal         @db.Decimal(15, 2)
  balanceAfter Decimal         @db.Decimal(15, 2)
  description  String?
  reference    String?
  createdById  String?
  createdAt    DateTime        @default(now())

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment      Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId])
  @@index([businessId, createdAt])
}

model InvoiceSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  prefix        String   @default("INV")
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String                @id @default(cuid())
  businessId     String
  customerId     String?
  invoiceNumber  String
  status         InvoiceStatus         @default(DRAFT)
  issueDate      DateTime              @default(now())
  dueDate        DateTime?
  subtotal       Decimal               @default(0) @db.Decimal(15, 2)
  discountAmount Decimal               @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal               @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal               @default(0) @db.Decimal(15, 2)
  paidAmount     Decimal               @default(0) @db.Decimal(15, 2)
  balanceDue     Decimal               @default(0) @db.Decimal(15, 2)
  notes          String?
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  payments       Payment[]
  ledgerEntries  CustomerLedgerEntry[]
  createdBy      User?                 @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([businessId, invoiceNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([customerId])
  @@index([businessId, status])
  @@index([businessId, issueDate])
}

model InvoiceItem {
  id                  String   @id @default(cuid())
  invoiceId           String
  productId           String?
  productNameSnapshot String
  skuSnapshot         String
  unitSnapshot        String   @default("PCS")
  quantity            Decimal  @db.Decimal(15, 4)
  unitPrice           Decimal  @db.Decimal(15, 2)
  unitCostSnapshot    Decimal  @default(0) @db.Decimal(15, 2)
  discount            Decimal  @default(0) @db.Decimal(15, 2)
  taxRate             Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal  @default(0) @db.Decimal(15, 2)
  lineSubtotal        Decimal  @db.Decimal(15, 2)
  lineTotal           Decimal  @db.Decimal(15, 2)

  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id             String                @id @default(cuid())
  businessId     String
  invoiceId      String?
  customerId     String?
  amount         Decimal               @db.Decimal(15, 2)
  paymentMethod  PaymentMethod         @default(CASH)
  reference      String?
  notes          String?
  idempotencyKey String?
  receivedAt     DateTime              @default(now())
  createdById    String?
  createdAt      DateTime              @default(now())

  // Reversal metadata. Nullable: a payment is reversible only until it has been reversed.
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice        Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ledgerEntries  CustomerLedgerEntry[]
  createdBy      User?                 @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reversedBy     User?                 @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([businessId, createdAt])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TransactionStatus {
  DRAFT
  POSTED
  VOID
}

model Account {
  id          String      @id @default(cuid())
  businessId  String
  code        String
  name        String
  type        AccountType
  category    String?
  currency    String      @default("INR")
  balance     Decimal     @default(0) @db.Decimal(15, 2)
  isActive    Boolean     @default(true)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries          Entry[]
  expenseCategories ExpenseCategory[]
  expenses         Expense[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, type])
}

model Transaction {
  id                  String            @id @default(cuid())
  businessId          String
  transactionNumber   String
  date                DateTime          @default(now())
  description         String
  reference           String?
  sourceType          String?
  sourceId            String?
  reversalOfId        String?
  status              TransactionStatus @default(POSTED)
  requiresHumanReview Boolean           @default(false)
  verifiedStatus      String            @default("VERIFIED")
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy           User?             @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  entries             Entry[]

  @@unique([businessId, transactionNumber])
  @@index([businessId])
  @@index([businessId, date])
  @@index([businessId, status])
  @@index([businessId, sourceType, sourceId])
  @@index([reversalOfId])
}

model Entry {
  id            String      @id @default(cuid())
  transactionId String
  accountId     String
  debit         Decimal     @default(0) @db.Decimal(15, 2)
  credit        Decimal     @default(0) @db.Decimal(15, 2)
  description   String?
  createdAt     DateTime    @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
}

model Supplier {
  id               String            @id @default(cuid())
  businessId       String
  name             String
  contactPerson    String?
  email            String?
  phone            String?
  gstin            String?
  pan              String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  paymentTerms     String?           @default("DUE_ON_RECEIPT")
  creditLimit      Decimal?          @db.Decimal(15, 2)
  currentBalance   Decimal           @default(0) @db.Decimal(15, 2)
  archived         Boolean           @default(false)
  notes            String?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy        User?             @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  purchaseBills    PurchaseBill[]
  purchasePayments PurchasePayment[]
  expenses         Expense[]

  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, archived])
}

model PurchaseBill {
  id                    String              @id @default(cuid())
  businessId            String
  supplierId            String
  billNumber            String
  supplierInvoiceNumber String?
  status                PurchaseBillStatus  @default(RECEIVED)
  billDate              DateTime            @default(now())
  dueDate               DateTime?
  subtotal              Decimal             @default(0) @db.Decimal(15, 2)
  discountAmount        Decimal             @default(0) @db.Decimal(15, 2)
  taxAmount             Decimal             @default(0) @db.Decimal(15, 2)
  cgstAmount            Decimal             @default(0) @db.Decimal(15, 2)
  sgstAmount            Decimal             @default(0) @db.Decimal(15, 2)
  igstAmount            Decimal             @default(0) @db.Decimal(15, 2)
  totalAmount           Decimal             @default(0) @db.Decimal(15, 2)
  paidAmount            Decimal             @default(0) @db.Decimal(15, 2)
  balanceDue            Decimal             @default(0) @db.Decimal(15, 2)
  notes                 String?
  idempotencyKey        String?
  createdById           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier              Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy             User?               @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items                 PurchaseBillItem[]
  payments              PurchasePayment[]

  @@unique([businessId, billNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([supplierId])
  @@index([businessId, status])
  @@index([businessId, billDate])
}

model PurchaseBillItem {
  id                  String       @id @default(cuid())
  billId              String
  productId           String?
  productNameSnapshot String
  skuSnapshot         String?
  unitSnapshot        String?
  quantity            Decimal      @db.Decimal(15, 4)
  unitCost            Decimal      @db.Decimal(15, 2)
  discount            Decimal      @default(0) @db.Decimal(15, 2)
  taxRate             Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal      @default(0) @db.Decimal(15, 2)
  lineSubtotal        Decimal      @db.Decimal(15, 2)
  lineTotal           Decimal      @db.Decimal(15, 2)
  createdAt           DateTime     @default(now())

  bill                PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  product             Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([productId])
}

model PurchasePayment {
  id             String        @id @default(cuid())
  businessId     String
  billId         String?
  supplierId     String
  amount         Decimal       @db.Decimal(15, 2)
  paymentMethod  PaymentMethod @default(BANK_TRANSFER)
  paymentDate    DateTime      @default(now())
  reference      String?
  notes          String?
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bill           PurchaseBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  supplier       Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy      User?         @relation("PurchasePaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([billId])
  @@index([supplierId])
  @@index([businessId, paymentDate])
}

model ExpenseCategory {
  id               String    @id @default(cuid())
  businessId       String
  name             String
  code             String?
  defaultAccountId String?
  description      String?
  isTaxDeductible  Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultAccount   Account?  @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)
  expenses         Expense[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Expense {
  id             String           @id @default(cuid())
  businessId     String
  expenseNumber  String
  categoryId     String?
  accountId      String
  supplierId     String?
  payeeName      String
  amount         Decimal          @db.Decimal(15, 2)
  taxRate        Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal          @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal          @db.Decimal(15, 2)
  paymentMethod  PaymentMethod    @default(BANK_TRANSFER)
  paymentStatus  String           @default("PAID") // PAID, PENDING, CANCELLED
  expenseDate    DateTime         @default(now())
  reference      String?
  receiptUrl     String?
  notes          String?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account        Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy      User?            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([businessId, expenseNumber])
  @@index([businessId])
  @@index([accountId])
  @@index([categoryId])
  @@index([businessId, expenseDate])
}

model PurchaseSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  currentNumber Int      @default(0)
  prefix        String   @default("BILL")
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ExpenseSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  currentNumber Int      @default(0)
  prefix        String   @default("EXP")
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model TransactionSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
