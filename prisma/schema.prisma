datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MovementType {
  STOCK_IN
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
}

model User {
  id                 String               @id @default(cuid())
  supabaseUserId     String               @unique
  email              String               @unique
  name               String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  memberships        BusinessMember[]
  invitations        BusinessInvitation[]
  auditLogs          AuditLog[]
  createdProducts    Product[]            @relation("ProductCreatedBy")
  inventoryMovements InventoryMovement[] @relation("MovementCreatedBy")
}

model Business {
  id                    String               @id @default(cuid())
  name                  String
  accountType           String
  businessType          String
  country               String
  state                 String
  city                  String
  baseCurrency          String
  fiscalYearStart       String
  taxRegistrationStatus Boolean              @default(false)
  taxId                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  members               BusinessMember[]
  invitations           BusinessInvitation[]
  auditLogs             AuditLog[]
  products              Product[]
  batches               InventoryBatch[]
  inventoryMovements    InventoryMovement[]
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       Role     @default(STAFF)
  status     String   @default("ACTIVE") // ACTIVE, REMOVED, SUSPENDED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model BusinessInvitation {
  id           String           @id @default(cuid())
  businessId   String
  email        String
  role         Role             @default(STAFF)
  status       InvitationStatus @default(PENDING)
  invitedById  String
  invitedUserId String?
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([businessId])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
}

model Product {
  id                String              @id @default(cuid())
  businessId        String
  name              String
  description       String?
  SKU               String
  barcode           String?
  category          String?
  unit              String              @default("PCS")
  costPrice         Decimal             @default(0) @db.Decimal(15, 2)
  sellingPrice      Decimal             @default(0) @db.Decimal(15, 2)
  stockQuantity     Decimal             @default(0) @db.Decimal(15, 4)
  lowStockThreshold Decimal             @default(10) @db.Decimal(15, 4)
  taxCategory       String              @default("STANDARD")
  archived          Boolean             @default(false)
  createdById       String?
  updatedById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy         User?               @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  batches           InventoryBatch[]
  movements         InventoryMovement[]

  @@unique([businessId, SKU])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([businessId, archived])
  @@index([businessId, name])
  @@index([SKU])
  @@index([barcode])
}

model InventoryBatch {
  id                String              @id @default(cuid())
  businessId        String
  productId         String
  batchNumber       String
  quantity          Decimal             @db.Decimal(15, 4)
  remainingQuantity Decimal             @db.Decimal(15, 4)
  unitCost          Decimal             @db.Decimal(15, 2)
  receivedDate      DateTime            @default(now())
  expiryDate        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements         InventoryMovement[]

  @@index([businessId])
  @@index([productId])
  @@index([businessId, batchNumber])
}

model InventoryMovement {
  id                String              @id @default(cuid())
  businessId        String
  productId         String
  batchId           String?
  movementType      MovementType
  quantity          Decimal             @db.Decimal(15, 4)
  unitCost          Decimal?            @db.Decimal(15, 2)
  previousStock     Decimal             @db.Decimal(15, 4)
  resultingStock    Decimal             @db.Decimal(15, 4)
  reason            String?
  reference         String?
  createdById       String?
  createdAt         DateTime            @default(now())

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch             InventoryBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([productId])
  @@index([businessId, createdAt])
  @@index([businessId, movementType])
}
