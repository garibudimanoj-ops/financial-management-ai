generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                @id @default(cuid())
  supabaseUserId          String                @unique
  email                   String                @unique
  name                    String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  auditLogs               AuditLog[]
  invitations             BusinessInvitation[]
  memberships             BusinessMember[]
  createdLedgerEntries    CustomerLedgerEntry[] @relation("LedgerCreatedBy")
  createdExpenses         Expense[]             @relation("ExpenseCreatedBy")
  inventoryMovements      InventoryMovement[]   @relation("MovementCreatedBy")
  createdInvoices         Invoice[]             @relation("InvoiceCreatedBy")
  createdPayments         Payment[]             @relation("PaymentCreatedBy")
  reversedPayments        Payment[]             @relation("PaymentReversedBy")
  createdProducts         Product[]             @relation("ProductCreatedBy")
  createdPurchaseBills    PurchaseBill[]        @relation("PurchaseCreatedBy")
  createdPurchasePayments PurchasePayment[]     @relation("PurchasePaymentCreatedBy")
  createdSuppliers        Supplier[]            @relation("SupplierCreatedBy")
  createdTransactions     Transaction[]         @relation("TransactionCreatedBy")
}

model Business {
  id                    String                @id @default(cuid())
  name                  String
  accountType           String
  businessType          String
  country               String
  state                 String
  city                  String
  baseCurrency          String
  fiscalYearStart       String
  taxRegistrationStatus Boolean               @default(false)
  taxId                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  accounts              Account[]
  auditLogs             AuditLog[]
  invitations           BusinessInvitation[]
  members               BusinessMember[]
  customers             Customer[]
  ledgerEntries         CustomerLedgerEntry[]
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  expenseSequence       ExpenseSequence?
  batches               InventoryBatch[]
  inventoryMovements    InventoryMovement[]
  invoices              Invoice[]
  invoiceSequence       InvoiceSequence?
  payments              Payment[]
  products              Product[]
  purchaseBills         PurchaseBill[]
  purchasePayments      PurchasePayment[]
  purchaseSequence      PurchaseSequence?
  suppliers             Supplier[]
  transactions          Transaction[]
  transactionSequence   TransactionSequence?
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       Role     @default(STAFF)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model BusinessInvitation {
  id            String           @id @default(cuid())
  businessId    String
  email         String
  role          Role             @default(STAFF)
  status        InvitationStatus @default(PENDING)
  invitedById   String
  invitedUserId String?
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy     User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([businessId])
  @@index([email])
}

model AuditLog {
  id         String    @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  details    Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
}

model Product {
  id                String              @id @default(cuid())
  businessId        String
  name              String
  description       String?
  SKU               String
  barcode           String?
  category          String?
  unit              String              @default("PCS")
  costPrice         Decimal             @default(0) @db.Decimal(15, 2)
  sellingPrice      Decimal             @default(0) @db.Decimal(15, 2)
  stockQuantity     Decimal             @default(0) @db.Decimal(15, 4)
  lowStockThreshold Decimal             @default(10) @db.Decimal(15, 4)
  taxCategory       String              @default("STANDARD")
  archived          Boolean             @default(false)
  createdById       String?
  updatedById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  batches           InventoryBatch[]
  movements         InventoryMovement[]
  invoiceItems      InvoiceItem[]
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy         User?               @relation("ProductCreatedBy", fields: [createdById], references: [id])
  purchaseItems     PurchaseBillItem[]

  @@unique([businessId, SKU])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([businessId, archived])
  @@index([businessId, name])
  @@index([SKU])
  @@index([barcode])
}

model InventoryBatch {
  id                String              @id @default(cuid())
  businessId        String
  productId         String
  batchNumber       String
  quantity          Decimal             @db.Decimal(15, 4)
  remainingQuantity Decimal             @db.Decimal(15, 4)
  unitCost          Decimal             @db.Decimal(15, 2)
  receivedDate      DateTime            @default(now())
  expiryDate        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements         InventoryMovement[]

  @@index([businessId])
  @@index([productId])
  @@index([businessId, batchNumber])
}

model InventoryMovement {
  id             String          @id @default(cuid())
  businessId     String
  productId      String
  batchId        String?
  movementType   MovementType
  quantity       Decimal         @db.Decimal(15, 4)
  unitCost       Decimal?        @db.Decimal(15, 2)
  previousStock  Decimal         @db.Decimal(15, 4)
  resultingStock Decimal         @db.Decimal(15, 4)
  reason         String?
  reference      String?
  createdById    String?
  createdAt      DateTime        @default(now())
  batch          InventoryBatch? @relation(fields: [batchId], references: [id])
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("MovementCreatedBy", fields: [createdById], references: [id])
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  @@index([businessId, createdAt])
  @@index([businessId, movementType])
}

model Customer {
  id             String                @id @default(cuid())
  businessId     String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String?               @default("India")
  taxId          String?
  notes          String?
  creditLimit    Decimal?              @db.Decimal(15, 2)
  openingBalance Decimal               @default(0) @db.Decimal(15, 2)
  currentBalance Decimal               @default(0) @db.Decimal(15, 2)
  archived       Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ledgerEntries  CustomerLedgerEntry[]
  invoices       Invoice[]
  payments       Payment[]

  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, archived])
}

model CustomerLedgerEntry {
  id           String          @id @default(cuid())
  businessId   String
  customerId   String
  invoiceId    String?
  paymentId    String?
  entryType    LedgerEntryType
  amount       Decimal         @db.Decimal(15, 2)
  balanceAfter Decimal         @db.Decimal(15, 2)
  description  String?
  reference    String?
  createdById  String?
  createdAt    DateTime        @default(now())
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation("LedgerCreatedBy", fields: [createdById], references: [id])
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id])
  payment      Payment?        @relation(fields: [paymentId], references: [id])

  @@index([businessId])
  @@index([customerId])
  @@index([businessId, createdAt])
}

model InvoiceSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  prefix        String   @default("INV")
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String                @id @default(cuid())
  businessId     String
  customerId     String?
  invoiceNumber  String
  status         InvoiceStatus         @default(DRAFT)
  issueDate      DateTime              @default(now())
  dueDate        DateTime?
  subtotal       Decimal               @default(0) @db.Decimal(15, 2)
  discountAmount Decimal               @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal               @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal               @default(0) @db.Decimal(15, 2)
  paidAmount     Decimal               @default(0) @db.Decimal(15, 2)
  balanceDue     Decimal               @default(0) @db.Decimal(15, 2)
  notes          String?
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  ledgerEntries  CustomerLedgerEntry[]
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy      User?                 @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  customer       Customer?             @relation(fields: [customerId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]

  @@unique([businessId, invoiceNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([customerId])
  @@index([businessId, status])
  @@index([businessId, issueDate])
}

model InvoiceItem {
  id                  String   @id @default(cuid())
  invoiceId           String
  productId           String?
  productNameSnapshot String
  skuSnapshot         String
  unitSnapshot        String   @default("PCS")
  quantity            Decimal  @db.Decimal(15, 4)
  unitPrice           Decimal  @db.Decimal(15, 2)
  unitCostSnapshot    Decimal  @default(0) @db.Decimal(15, 2)
  discount            Decimal  @default(0) @db.Decimal(15, 2)
  taxRate             Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal  @default(0) @db.Decimal(15, 2)
  lineSubtotal        Decimal  @db.Decimal(15, 2)
  lineTotal           Decimal  @db.Decimal(15, 2)
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id             String                @id @default(cuid())
  businessId     String
  invoiceId      String?
  customerId     String?
  amount         Decimal               @db.Decimal(15, 2)
  paymentMethod  PaymentMethod         @default(CASH)
  reference      String?
  notes          String?
  idempotencyKey String?
  receivedAt     DateTime              @default(now())
  createdById    String?
  createdAt      DateTime              @default(now())
  reversalReason String?
  reversedAt     DateTime?
  reversedById   String?
  ledgerEntries  CustomerLedgerEntry[]
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy      User?                 @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  customer       Customer?             @relation(fields: [customerId], references: [id])
  invoice        Invoice?              @relation(fields: [invoiceId], references: [id])
  reversedBy     User?                 @relation("PaymentReversedBy", fields: [reversedById], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([businessId, createdAt])
}

model Account {
  id                String            @id @default(cuid())
  businessId        String
  code              String
  name              String
  type              AccountType
  category          String?
  currency          String            @default("INR")
  balance           Decimal           @default(0) @db.Decimal(15, 2)
  isActive          Boolean           @default(true)
  description       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries           Entry[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, type])
}

model Transaction {
  id                  String            @id @default(cuid())
  businessId          String
  transactionNumber   String
  date                DateTime          @default(now())
  description         String
  reference           String?
  status              TransactionStatus @default(POSTED)
  requiresHumanReview Boolean           @default(false)
  verifiedStatus      String            @default("VERIFIED")
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  reversalOfId        String?
  sourceId            String?
  sourceType          String?
  entries             Entry[]
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy           User?             @relation("TransactionCreatedBy", fields: [createdById], references: [id])

  @@unique([businessId, transactionNumber])
  @@index([businessId])
  @@index([businessId, date])
  @@index([businessId, status])
  @@index([businessId, sourceType, sourceId])
  @@index([reversalOfId])
}

model Entry {
  id            String      @id @default(cuid())
  transactionId String
  accountId     String
  debit         Decimal     @default(0) @db.Decimal(15, 2)
  credit        Decimal     @default(0) @db.Decimal(15, 2)
  description   String?
  createdAt     DateTime    @default(now())
  account       Account     @relation(fields: [accountId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([accountId])
}

model Supplier {
  id               String            @id @default(cuid())
  businessId       String
  name             String
  contactPerson    String?
  email            String?
  phone            String?
  gstin            String?
  pan              String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  paymentTerms     String?           @default("DUE_ON_RECEIPT")
  creditLimit      Decimal?          @db.Decimal(15, 2)
  currentBalance   Decimal           @default(0) @db.Decimal(15, 2)
  archived         Boolean           @default(false)
  notes            String?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  expenses         Expense[]
  purchaseBills    PurchaseBill[]
  purchasePayments PurchasePayment[]
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy        User?             @relation("SupplierCreatedBy", fields: [createdById], references: [id])

  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, archived])
}

model PurchaseBill {
  id                    String             @id @default(cuid())
  businessId            String
  supplierId            String
  billNumber            String
  supplierInvoiceNumber String?
  status                PurchaseBillStatus @default(RECEIVED)
  billDate              DateTime           @default(now())
  dueDate               DateTime?
  subtotal              Decimal            @default(0) @db.Decimal(15, 2)
  discountAmount        Decimal            @default(0) @db.Decimal(15, 2)
  taxAmount             Decimal            @default(0) @db.Decimal(15, 2)
  cgstAmount            Decimal            @default(0) @db.Decimal(15, 2)
  sgstAmount            Decimal            @default(0) @db.Decimal(15, 2)
  igstAmount            Decimal            @default(0) @db.Decimal(15, 2)
  totalAmount           Decimal            @default(0) @db.Decimal(15, 2)
  paidAmount            Decimal            @default(0) @db.Decimal(15, 2)
  balanceDue            Decimal            @default(0) @db.Decimal(15, 2)
  notes                 String?
  idempotencyKey        String?
  createdById           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  business              Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy             User?              @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  supplier              Supplier           @relation(fields: [supplierId], references: [id])
  items                 PurchaseBillItem[]
  payments              PurchasePayment[]

  @@unique([businessId, billNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([supplierId])
  @@index([businessId, status])
  @@index([businessId, billDate])
}

model PurchaseBillItem {
  id                  String       @id @default(cuid())
  billId              String
  productId           String?
  productNameSnapshot String
  skuSnapshot         String?
  unitSnapshot        String?
  quantity            Decimal      @db.Decimal(15, 4)
  unitCost            Decimal      @db.Decimal(15, 2)
  discount            Decimal      @default(0) @db.Decimal(15, 2)
  taxRate             Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal      @default(0) @db.Decimal(15, 2)
  lineSubtotal        Decimal      @db.Decimal(15, 2)
  lineTotal           Decimal      @db.Decimal(15, 2)
  createdAt           DateTime     @default(now())
  bill                PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  product             Product?     @relation(fields: [productId], references: [id])

  @@index([billId])
  @@index([productId])
}

model PurchasePayment {
  id             String        @id @default(cuid())
  businessId     String
  billId         String?
  supplierId     String
  amount         Decimal       @db.Decimal(15, 2)
  paymentMethod  PaymentMethod @default(BANK_TRANSFER)
  paymentDate    DateTime      @default(now())
  reference      String?
  notes          String?
  idempotencyKey String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  bill           PurchaseBill? @relation(fields: [billId], references: [id])
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy      User?         @relation("PurchasePaymentCreatedBy", fields: [createdById], references: [id])
  supplier       Supplier      @relation(fields: [supplierId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([billId])
  @@index([supplierId])
  @@index([businessId, paymentDate])
}

model ExpenseCategory {
  id               String    @id @default(cuid())
  businessId       String
  name             String
  code             String?
  defaultAccountId String?
  description      String?
  isTaxDeductible  Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expenses         Expense[]
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultAccount   Account?  @relation(fields: [defaultAccountId], references: [id])

  @@unique([businessId, name])
  @@index([businessId])
}

model Expense {
  id            String           @id @default(cuid())
  businessId    String
  expenseNumber String
  categoryId    String?
  accountId     String
  supplierId    String?
  payeeName     String
  amount        Decimal          @db.Decimal(15, 2)
  taxRate       Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal          @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal          @db.Decimal(15, 2)
  paymentMethod PaymentMethod    @default(BANK_TRANSFER)
  paymentStatus String           @default("PAID")
  expenseDate   DateTime         @default(now())
  reference     String?
  receiptUrl    String?
  notes         String?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  account       Account          @relation(fields: [accountId], references: [id])
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])
  createdBy     User?            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])

  @@unique([businessId, expenseNumber])
  @@index([businessId])
  @@index([accountId])
  @@index([categoryId])
  @@index([businessId, expenseDate])
}

model PurchaseSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  currentNumber Int      @default(0)
  prefix        String   @default("BILL")
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ExpenseSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  currentNumber Int      @default(0)
  prefix        String   @default("EXP")
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model TransactionSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MovementType {
  STOCK_IN
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PurchaseBillStatus {
  DRAFT
  RECEIVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  REFUND
  CREDIT
  DEBIT
  OPENING_BALANCE
  ADJUSTMENT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TransactionStatus {
  DRAFT
  POSTED
  VOID
}
